<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_fragment_inicio">

        <TextView
            android:id="@+id/textViewTituloOrdenes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_ordenes"
            android:textColor="@color/azul_oscuro"
            android:textSize="@dimen/size_inicio_titulo"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <ProgressBar
            android:id="@+id/progressIndicator"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardListaVacia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="25dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

        <TextView
            android:id="@+id/textViewListaVacia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/sin_ordenes"
            android:textColor="@color/azul_oscuro"
            android:textSize="@dimen/text_body" />

        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerOrdenes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabNuevaOrden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="52dp"
            android:text="@string/orden_crear"
            android:textColor="@color/white"
            android:textAllCaps="false"
            app:backgroundTint="@color/naranja"
            app:cornerRadius="25dp"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

