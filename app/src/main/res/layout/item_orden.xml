<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/textViewFechaOrden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/orden_fecha"
            android:textColor="@color/azul_oscuro"
            android:textSize="12sp" />


    <TextView
        android:id="@+id/textViewProveedorOrden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/orden_proveedor"
        android:textColor="@color/azul_oscuro"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/textViewTotalOrden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/orden_total"
        android:textColor="@color/naranja"
        android:textSize="16sp"
        android:textStyle="bold" />


    <com.google.android.material.chip.Chip
        android:id="@+id/chipEstadoOrden"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:checkable="false"
        android:clickable="false"
        android:text="@string/orden_estado_pendiente"
        android:textColor="@color/azul_oscuro"
        app:chipBackgroundColor="@color/card_pendientes"/>

    <com.google.android.material.chip.Chip
        android:id="@+id/chipPendienteSync"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checkable="false"
        android:clickable="false"
        android:text="@string/orden_pendiente_sync"
        android:textColor="@color/azul_oscuro"
        android:visibility="gone"/>






</LinearLayout>


</com.google.android.material.card.MaterialCardView>